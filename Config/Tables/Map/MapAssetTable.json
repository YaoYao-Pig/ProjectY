{
  "version": 1,
  "name": "MapAssetTable",
  "description": "地图表现资源；地貌、装饰、建筑统一引用 ID，Unity 绑定路径，Web 使用预览轮廓。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "资源 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "string",
      "description": "资源名称"
    },
    {
      "name": "prefabPath",
      "type": "string",
      "description": "Unity GameObject 资源路径，须位于 Assets/"
    },
    {
      "name": "previewShape",
      "type": "string",
      "description": "Web 轮廓：terrain/platform/water/mountain/house/workshop/hall/castle/dungeon/tree/conifer/snowpine"
    },
    {
      "name": "previewColor",
      "type": "string",
      "description": "Web 装饰与建筑基色，#RRGGBB"
    },
    {
      "name": "referenceHeight",
      "type": "float",
      "description": "模型基准高度；建筑实际缩放为配表总高除以此值",
      "min": 0.01
    },
    {
      "name": "footprintRadius",
      "type": "int",
      "description": "资源适配占地：0 单格，1 七格",
      "min": 0,
      "max": 1
    },
    {
      "name": "tintMaterial",
      "type": "string",
      "description": "地表/平台顶面或水面材质名；装饰及建筑留空保留模型颜色"
    }
  ],
