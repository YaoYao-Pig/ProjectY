{
  "version": 1,
  "name": "MapRegionTable",
  "description": "地貌策略参数。X/Y 为不规则轮廓的 q/r 采样包围盒格数，实际格数小于包围盒面积；高度使用 Unity 世界单位。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "区域配置 ID，不是运行时实例 ID",
      "min": 1
    },
    {
      "name": "MapRegion",
      "type": "enum",
      "enumRef": "Map.E_MapRegion",
      "description": "地貌类型，对应生成器与实例类"
    },
    {
      "name": "minX",
      "type": "float",
      "description": "q 轴最小格数，向上取整",
      "min": 1
    },
    {
      "name": "maxX",
      "type": "float",
      "description": "q 轴最大格数，向下取整",
      "min": 1
    },
    {
      "name": "minY",
      "type": "float",
      "description": "r 轴最小格数，向上取整",
      "min": 1
    },
    {
      "name": "maxY",
      "type": "float",
      "description": "r 轴最大格数，向下取整",
      "min": 1
    },
    {
      "name": "minHeight",
      "type": "float",
      "description": "策略原始地面最低高度；最终边界过渡允许超出此范围"
    },
    {
      "name": "maxHeight",
      "type": "float",
      "description": "策略原始地面最高高度；最终边界过渡允许超出此范围"
    },
    {
      "name": "shapeIrregularity",
      "type": "float",
      "default": 0.65,
      "min": 0,
      "max": 1,
      "description": "区域轮廓扰动幅度，0 为圆润轮廓，1 更曲折"
    },
    {
      "name": "noiseScale",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 8,
      "description": "基础噪声跨度的倍率；越大则山体/起伏越宽"
    },
    {
      "name": "roughness",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "分形噪声每层保留的振幅比例，越大细节越粗糙"
    },
    {
      "name": "warpStrength",
      "type": "float",
      "default": 0.7,
      "min": 0,
      "max": 2,
      "description": "采样坐标扰动强度，减少规则噪声形状"
    },
    {
      "name": "waterLevel",
      "type": "float",
      "default": 0,
      "description": "河湖目标水位，须位于该策略的 minHeight 与 maxHeight 之间；其他策略忽略"
    },
    {
      "name": "riverWidth",
      "type": "float",
      "default": 1.5,
      "min": 0.5,
      "max": 12,
      "description": "河谷横断面宽度参数，格子单位；仅河流策略使用"
    },
    {
      "name": "lakeSize",
      "type": "float",
      "default": 0.5,
      "min": 0.15,
      "max": 0.75,
      "description": "湖泊盆地占区域半径的比例；仅湖泊策略使用"
    },
    {
      "name": "hydrologyProfileId",
      "type": "int",
      "description": "水文局部参数；接缝按 Region 实例权重混合",
      "ref": "MapHydrologyProfileTable"
    }
  ],
