{
  "version": 1,
  "name": "MapBiomeTable",
  "description": "地貌表现与散布规则；边界颜色按生成器的 biomeWeights 混合。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "地貌策略数值，对应 E_MapRegion",
      "min": 1
    },
    {
      "name": "terrainAssetId",
      "type": "int",
      "description": "地表模型",
      "ref": "MapAssetTable"
    },
    {
      "name": "terrainVariantAssetIds",
      "type": "int[]",
      "default": [],
      "ref": "MapAssetTable",
      "description": "可选地块模型池，按种子位置噪声成片抽取；空数组沿用 terrainAssetId"
    },
    {
      "name": "waterAssetId",
      "type": "int",
      "description": "水面模型",
      "ref": "MapAssetTable"
    },
    {
      "name": "groundColor",
      "type": "string",
      "description": "地表基色 #RRGGBB"
    },
    {
      "name": "decorationAssetIds",
      "type": "int[]",
      "description": "可散布的装饰模型，空数组关闭",
      "ref": "MapAssetTable"
    },
    {
      "name": "decorationDensity",
      "type": "float",
      "description": "候选格散布概率，按地貌权重与位置噪声控制",
      "min": 0,
      "max": 1
    },
    {
      "name": "decorationMaxSlope",
      "type": "float",
      "description": "装饰格与六邻格的最大高度差",
      "min": 0,
      "max": 20
    },
    {
      "name": "minScale",
      "type": "float",
      "description": "装饰最小等比缩放",
      "min": 0.1,
      "max": 3
    },
    {
      "name": "maxScale",
      "type": "float",
      "description": "装饰最大等比缩放",
      "min": 0.1,
      "max": 3
    },
    {
      "name": "groundTexture",
      "type": "string",
      "description": "地表贴图 Resources 相对路径"
    },
    {
      "name": "textureWorldSize",
      "type": "float",
      "description": "地表纹理平铺尺寸，相对于六边形半径",
      "min": 0.1
    },
    {
      "name": "textureStrength",
      "type": "float",
      "description": "地表纹理混合强度",
      "min": 0,
      "max": 1
    },
    {
      "name": "windStrength",
      "type": "float",
      "description": "植被轻风摆动强度",
      "min": 0,
      "max": 2
    },
    {
      "name": "groundcoverDensity",
      "type": "float",
      "description": "草花地被基础密度，叠加空间斑块",
      "min": 0,
      "max": 1
    },
    {
      "name": "shrubDensity",
      "type": "float",
      "description": "稀疏灌木基础密度",
      "min": 0,
      "max": 1
    },
    {
      "name": "butterflyDensity",
      "type": "float",
      "description": "蝴蝶活动点基础密度",
      "min": 0,
      "max": 1
    },
    {
      "name": "gnatDensity",
      "type": "float",
      "description": "小虫群活动点基础密度",
      "min": 0,
      "max": 1
    }
  ],
