{
  "version": 1,
  "name": "EquipmentRuneTable",
  "description": "可拆改装组件：符文与机械组件通过挂点和技能组限定效果。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "符文物品 ID",
      "ref": "EquipmentItemTable"
    },
    {
      "name": "slotKind",
      "type": "enum",
      "description": "插槽兼容性",
      "values": [
        "head",
        "shaft",
        "thruster",
        "catalyst",
        "rail",
        "edge",
        "grip",
        "pommel",
        "bowlimb",
        "bowstring",
        "muzzle",
        "stock"
      ]
    },
    {
      "name": "skillGroup",
      "type": "enum",
      "description": "受影响技能组",
      "values": [
        "spell",
        "slash",
        "physical"
      ]
    },
    {
      "name": "description",
      "type": "text",
      "description": "效果说明"
    },
    {
      "name": "damageMultiplier",
      "type": "float",
      "description": "伤害倍率",
      "min": 0.01,
      "max": 10
    },
    {
      "name": "rangeBonus",
      "type": "int",
      "description": "额外射程，可为负；敌方目标技能至少保留1格",
      "min": -10
    },
    {
      "name": "hitBonus",
      "type": "int",
      "description": "命中百分点增减，最终限制0至100",
      "min": -100,
      "max": 100
    },
    {
      "name": "cooldownBonus",
      "type": "int",
      "description": "自身回合冷却增减，最终不低于0",
      "min": -5
    },
    {
      "name": "maxTargets",
      "type": "int",
      "description": "最多合法目标数",
      "min": 1,
      "max": 8
    },
    {
      "name": "splashRadius",
      "type": "int",
      "description": "主目标附近追加目标的六边形半径",
      "min": 0
    },
    {
      "name": "catalystKind",
      "type": "enum",
      "values": [
        "none",
        "arcane"
      ],
      "default": "none",
      "description": "使当前武器提供的触媒类型；none不提供触媒"
    },
    {
      "name": "requiredTalentId",
      "type": "int",
      "min": 0,
      "default": 0,
      "description": "启用触媒所需的TalentNode专精；0表示无需专精"
    },
    {
      "name": "onHitEffectIds",
      "type": "int[]",
      "default": [],
      "ref": "CombatEffectTable",
      "description": "匹配技能组的对敌伤害命中后追加可复用效果；physical匹配weapon/slash；不作用于纯状态、治疗或自身技能"
    },
    {
      "name": "transferSelf",
      "type": "bool",
      "default": false,
      "description": "把允许转施的自身法术改为任意角色目标；不重定向source收益或道具动作"
    },
    {
      "name": "transferRange",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 12,
      "description": "转施后的固定施法距离；启用时必须大于0，覆盖其他射程增减"
    }
  ],
