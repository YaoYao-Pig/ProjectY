{
  "version": 1,
  "name": "EquipmentAffixTable",
  "description": "装备单词缀品质；实例生成时按类型和权重确定，维修不改变词缀。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "min": 1,
      "description": "稳定词缀 ID；1 固定为普通，兼容旧存档"
    },
    {
      "name": "name",
      "type": "text",
      "description": "装备名称前缀，普通不显示"
    },
    {
      "name": "color",
      "type": "string",
      "description": "品质显示色；支持带或不带 # 的 RGB/RGBA/RRGGBB/RRGGBBAA 十六进制",
      "default": "#B8C4D1"
    },
    {
      "name": "targetTypes",
      "type": "enum[]",
      "values": [
        "melee",
        "bow",
        "gun",
        "staff",
        "armor",
        "shield",
        "ring",
        "spear"
      ],
      "description": "适用类型；armor 为头、身、腿、脚，shield 为副手防具"
    },
    {
      "name": "weight",
      "type": "int",
      "min": 0,
      "max": 100000,
      "description": "适用池内的相对抽取权重；0 不随机出现但仍可读档"
    },
    {
      "name": "damageMultiplier",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 10,
      "description": "本武器攻击或本触媒法术的伤害倍率"
    },
    {
      "name": "hitBonus",
      "type": "int",
      "default": 0,
      "min": -100,
      "max": 100,
      "description": "对应攻击或法术的命中百分点加减，最终限制 0–100"
    },
    {
      "name": "attributeIds",
      "type": "int[]",
      "ref": "EquipmentAttributeTable",
      "description": "穿戴属性增减的属性 ID"
    },
    {
      "name": "attributeValues",
      "type": "int[]",
      "description": "与属性 ID 一一对应的有符号加成；计入耐久效能"
    }
  ],
  "rows": [
