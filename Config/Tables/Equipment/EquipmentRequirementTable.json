      "min": 0,
      "max": 1
    },
    {
      "name": "minimumDamageScale",
      "type": "float",
      "description": "最低伤害比例",
      "min": 0.01,
      "max": 1
    },
    {
      "name": "hitLossPerPoint",
      "type": "int",
      "description": "每个不足点扣减命中百分点",
      "min": 0
    },
    {
      "name": "maximumHitLoss",
      "type": "int",
      "description": "最高命中惩罚",
      "min": 0,
      "max": 100
    }
  ],
