{
  "version": 1,
  "name": "EquipmentWeaponTable",
  "description": "每把武器赋予技能；装备后替换角色原有基础武器攻击，保留防御和职业技能。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "武器物品 ID",
      "ref": "EquipmentItemTable"
    },
    {
      "name": "kind",
      "type": "enum",
      "description": "武器规则类别",
      "values": [
        "staff",
        "gun",
        "melee",
        "bow"
      ]
    },
    {
      "name": "socketIds",
      "type": "int[]",
      "description": "按顺序显示的挂点",
      "ref": "EquipmentSocketTable"
    },
    {
      "name": "skillIds",
      "type": "int[]",
      "description": "装备赋予的技能",
      "ref": "CombatSkillTable"
    },
    {
      "name": "replacesSkillIds",
      "type": "int[]",
      "description": "装备时替换的基础攻击",
      "ref": "CombatSkillTable"
    },
    {
      "name": "magazineItemId",
      "type": "int",
      "description": "兼容弹匣物品，0 表示不使用弹匣",
      "min": 0
    },
    {
      "name": "previewRotation",
      "type": "float[]",
      "description": "工坊默认预览角度 XYZ"
    },
    {
      "name": "previewZoom",
      "type": "float",
      "description": "工坊默认正交半高",
      "min": 0.7,
      "max": 2.6
    },
    {
      "name": "categoryId",
      "type": "int",
      "description": "武器种类",
      "ref": "EquipmentCategoryTable"
    },
    {
      "name": "level",
      "type": "int",
      "description": "装备等级（不是角色等级门槛）",
      "min": 1
    },
    {
      "name": "damageMultiplier",
      "type": "float",
      "description": "此武器授予攻击的伤害倍率",
      "min": 0.01,
      "max": 10
    },
    {
      "name": "requirementId",
      "type": "int",
      "description": "装配时不计装备加成的属性硬门槛；已装备后不足仍按规则削弱武器技能",
      "ref": "EquipmentRequirementTable"
    },
    {
      "name": "hands",
      "type": "int",
      "description": "占用手数；双手武器与副手互斥",
      "min": 1,
      "max": 2
    },
    {
      "name": "offhandSkillId",
      "type": "int",
      "description": "副手授予技能；0 表示不可放入副手",
      "min": 0
    },
    {
      "name": "gripId",
      "type": "int",
      "description": "武器独立握点配置",
      "ref": "EquipmentGripTable",
      "default": 1
    },
    {
      "name": "gunClass",
      "type": "string",
      "description": "枪型选择动作匹配规则；非枪为空",
      "default": ""
    },
    {
      "name": "tagIds",
      "type": "string[]",
      "description": "按详情显示顺序排列的武器标签，可同时配置多个",
      "ref": "EquipmentWeaponTagTable",
      "default": []
    },
    {
      "name": "catalystKind",
      "type": "enum",
      "values": [
        "none",
        "arcane"
      ],
      "default": "none",
      "description": "原生施法触媒类型；不授予已学法术"
    },
    {
      "name": "onHitEffectIds",
      "type": "int[]",
      "default": [],
      "ref": "CombatEffectTable",
      "description": "本武器攻击命中后执行的共享效果动作，不作用于其他武器或法术"
    },
    {
      "name": "description",
      "type": "text",
      "default": "",
      "description": "武器独特用途与取舍，背包详情显示"
    }
  ],
