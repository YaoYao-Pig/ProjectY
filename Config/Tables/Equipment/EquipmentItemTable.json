{
  "version": 1,
  "name": "EquipmentItemTable",
  "description": "共享网格背包物品定义；实例装备按矩形占格，组件和散弹药按物品类型堆叠。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "text",
      "description": "显示名称"
    },
    {
      "name": "kind",
      "type": "enum",
      "description": "物品类别",
      "values": [
        "weapon",
        "rune",
        "magazine",
        "ammo",
        "module",
        "wearable"
      ]
    },
    {
      "name": "assetId",
      "type": "int",
      "description": "三维展示资源",
      "ref": "EquipmentAssetTable"
    },
    {
      "name": "iconPath",
      "type": "string",
      "description": "UI Sprite 路径；空字符串显示留白图标"
    },
    {
      "name": "width",
      "type": "int",
      "description": "未旋转时占用列数",
      "min": 1,
      "max": 12
    },
    {
      "name": "height",
      "type": "int",
      "description": "未旋转时占用行数",
      "min": 1,
      "max": 10
    },
    {
      "name": "iconMode",
      "type": "enum",
      "description": "model 按模型导出；file 使用人工 Sprite；none 无图标",
      "values": [
        "model",
        "file",
        "none"
      ]
    },
    {
      "name": "iconRotation",
      "type": "float[]",
      "description": "图标模型旋转 XYZ"
    },
    {
      "name": "iconPadding",
      "type": "float",
      "description": "图标包围盒留白倍率",
      "min": 1,
      "max": 2
    }
  ],
