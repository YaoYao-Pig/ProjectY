{
  "version": 1,
  "name": "EquipmentLootTable",
  "description": "每个搜刮点只领取一次；物品与数量按顺序对应。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "text",
      "description": "显示名称"
    },
    {
      "name": "kind",
      "type": "enum",
      "description": "展示形态",
      "values": [
        "chest",
        "ground"
      ]
    },
    {
      "name": "assetId",
      "type": "int",
      "description": "未搜刮模型",
      "ref": "EquipmentAssetTable"
    },
    {
      "name": "openedAssetId",
      "type": "int",
      "description": "宝箱开启后的模型；地面物品领取后隐藏",
      "ref": "EquipmentAssetTable"
    },
    {
      "name": "itemIds",
      "type": "int[]",
      "description": "掉落物品",
      "ref": "EquipmentItemTable"
    },
    {
      "name": "counts",
      "type": "int[]",
      "description": "对应数量，必须为正"
    },
    {
      "name": "poolId",
      "type": "int",
      "description": "随机池 ID；0 使用固定 itemIds/counts",
      "min": 0,
      "default": 0
    }
  ],
