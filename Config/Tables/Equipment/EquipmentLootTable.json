{
  "version": 1,
  "name": "EquipmentLootTable",
  "description": "容器表现、交互、耐久与默认掉落池；打开、破坏和取空独立记录。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "text",
      "description": "显示名称"
    },
    {
      "name": "kind",
      "type": "enum",
      "description": "展示形态",
      "values": [
        "chest",
        "ground"
      ]
    },
    {
      "name": "assetId",
      "type": "int",
      "description": "未搜刮模型",
      "ref": "EquipmentAssetTable"
    },
    {
      "name": "openedAssetId",
      "type": "int",
      "description": "宝箱开启后的模型；地面物品领取后隐藏",
      "ref": "EquipmentAssetTable"
    },
    {
      "name": "itemIds",
      "type": "int[]",
      "description": "掉落物品",
      "ref": "EquipmentItemTable"
    },
    {
      "name": "counts",
      "type": "int[]",
      "description": "对应数量，必须为正"
    },
    {
      "name": "poolId",
      "type": "int",
      "description": "随机池 ID；0 使用固定 itemIds/counts",
      "min": 0,
      "default": 0
    },
    {
      "name": "interaction",
      "type": "enum",
      "description": "打开、搜刮、必须打碎或装备工具后开启",
      "default": "open",
      "values": [
        "open",
        "search",
        "break",
        "tool"
      ]
    },
    {
      "name": "toolTag",
      "type": "string",
      "description": "tool 交互所需的已装备工具标签，其他方式为空",
      "default": ""
    },
    {
      "name": "maxDurability",
      "type": "int",
      "description": "最大耐久；0 为不可破坏",
      "default": 0,
      "min": 0
    },
    {
      "name": "structuralDefense",
      "type": "int",
      "description": "结构防御，代入技能伤害公式的 defense",
      "default": 0,
      "min": 0
    },
    {
      "name": "blocksMovement",
      "type": "bool",
      "description": "完整/开启容器占地阻挡；破坏后清除",
      "default": false
    },
    {
      "name": "blocksSight",
      "type": "bool",
      "description": "完整容器是否阻挡视线",
      "default": false
    },
    {
      "name": "brokenAssetId",
      "type": "int",
      "description": "破坏后残骸模型，0 为不保留残骸",
      "default": 0,
      "min": 0
    },
    {
      "name": "emptyAssetId",
      "type": "int",
      "description": "取空后模型，0 沿用开启模型",
      "default": 0,
      "min": 0
    },
    {
      "name": "modelScale",
      "type": "float",
      "description": "模型等比缩放",
      "default": 1,
      "min": 0.01
    },
    {
      "name": "footprintQ",
      "type": "int[]",
      "description": "占地轴向 q，首项为锚点 0",
      "default": [
        0
      ]
    },
    {
      "name": "footprintR",
      "type": "int[]",
      "description": "占地轴向 r，与 q 成对",
      "default": [
        0
      ]
    },
    {
      "name": "displayContents",
      "type": "enum",
      "description": "开放式容器上显示剩余真实物品",
      "default": "none",
      "values": [
        "none",
        "rack",
        "surface"
      ]
    },
    {
      "name": "displayHeight",
      "type": "float",
      "description": "开放式容器物品显示高度（模型局部米）",
      "default": 0.9,
      "min": 0
    },
    {
      "name": "displayItemScale",
      "type": "float",
      "description": "开放式容器展示物品的模型缩放",
      "default": 0.6,
      "min": 0.01
    },
    {
      "name": "interactionRounds",
      "type": "int",
      "description": "首次工具开启消耗的探索回合",
      "default": 0,
      "min": 0
    }
  ],
