{
  "version": 1,
  "name": "EquipmentMotionModuleTable",
  "description": "动作模组与武器几何握点分离；动画持握配置可独立编辑",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "动作模组 ID",
      "min": 1
    },
    {
      "name": "code",
      "type": "string",
      "description": "稳定模组名"
    },
    {
      "name": "name",
      "type": "text",
      "description": "模组名称"
    },
    {
      "name": "poseId",
      "type": "int",
      "description": "基础身体与双手位置",
      "ref": "EquipmentPoseTable"
    },
    {
      "name": "holdId",
      "type": "int",
      "description": "PawnAnimations 中独立的持握动画配置 ID",
      "min": 0
    },
    {
      "name": "sourceHoldId",
      "type": "int",
      "description": "首次创建持握配置时复制的已存在模板",
      "min": 0
    },
    {
      "name": "offHandMode",
      "type": "enum",
      "description": "副手解算方式",
      "values": [
        "free",
        "shield",
        "shared",
        "independent"
      ]
    },
    {
      "name": "attackActionId",
      "type": "int",
      "description": "主手的默认动作表现模板",
      "ref": "EquipmentActionTable"
    },
    {
      "name": "offActionId",
      "type": "int",
      "description": "副手攻击表现模板；0 为不提供",
      "ref": "EquipmentActionTable"
    },
    {
      "name": "lockWeaponOrientation",
      "type": "bool",
      "default": false,
      "description": "动作期间也保持模组规定的武器朝向，适用于一手持杖、另一手施法"
    }
  ],
  "rows": [
    {
