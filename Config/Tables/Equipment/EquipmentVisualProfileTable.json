{
  "version": 1,
  "name": "EquipmentVisualProfileTable",
  "description": "通用装备持续视觉配置。assetId显式绑定可复用组件；控制局部辉光材质、现有方块粒子锚点与有预算的点光，不按传奇品质或物品ID特判。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "独立装备外观配置ID；不决定品质或战斗规则",
      "min": 1
    },
    {
      "name": "name",
      "type": "text",
      "description": "编辑器备注"
    },
    {
      "name": "assetId",
      "type": "int",
      "description": "显式绑定装备资源；每个资源至多一个外观配置",
      "ref": "EquipmentAssetTable",
      "min": 1
    },
    {
      "name": "color",
      "type": "string",
      "description": "主辉光颜色 #RRGGBB"
    },
    {
      "name": "accent",
      "type": "string",
      "description": "流动光带和粒子点缀颜色 #RRGGBB"
    },
    {
      "name": "emission",
      "type": "float",
      "description": "HDR辉光与局部粒子亮度",
      "min": 0,
      "max": 8
    },
    {
      "name": "pulseSpeed",
      "type": "float",
      "description": "辉光呼吸速度，弧度每秒",
      "min": 0,
      "max": 12
    },
    {
      "name": "pulseAmount",
      "type": "float",
      "description": "呼吸变化幅度",
      "min": 0,
      "max": 1
    },
    {
      "name": "flowSpeed",
      "type": "float",
      "description": "沿模型光带移动速度",
      "min": -8,
      "max": 8
    },
    {
      "name": "flowScale",
      "type": "float",
      "description": "每米光带密度",
      "min": 0.1,
      "max": 30
    },
    {
      "name": "glowMaterialNames",
      "type": "string[]",
      "description": "需替换为通用辉光Shader的原始材质名称；其余材质保持不变"
    },
    {
      "name": "particleAnchors",
      "type": "float[]",
      "description": "Unity装备本地坐标xyz扁平数组；最多4个发射锚点；构图复用物品VisualEffectTable"
    },
    {
      "name": "particleInterval",
      "type": "float",
      "description": "每次小规模粒子脉冲间隔秒",
      "min": 0.5,
      "max": 10
    },
    {
      "name": "particleScale",
      "type": "float",
      "description": "局部粒子缩放",
      "min": 0.1,
      "max": 2
    },
    {
      "name": "particleCount",
      "type": "int",
      "description": "每锚点每次粒子上限，复用现有全局粒子预算",
      "min": 1,
      "max": 8
    },
    {
      "name": "lightAnchor",
      "type": "float[]",
      "description": "可选点光本地坐标xyz；点光永不投影"
    },
    {
      "name": "lightColor",
      "type": "string",
      "description": "点光颜色 #RRGGBB"
    },
    {
      "name": "lightIntensity",
      "type": "float",
      "description": "局部点光强度，0关闭；每相机最多4盏",
      "min": 0,
      "max": 2
    },
    {
      "name": "lightRange",
      "type": "float",
      "description": "局部点光范围，米",
      "min": 0.1,
      "max": 3
    },
    {
      "name": "maxVisibleDistance",
      "type": "float",
      "description": "距当前渲染相机的最大点光距离，米",
      "min": 1,
      "max": 120
    }
  ],
