{
  "version": 1,
  "name": "CombatSkillTable",
  "description": "技能由行动类型、目标规则、消耗和效果序列组成。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "text",
      "description": "技能名称"
    },
    {
      "name": "description",
      "type": "text",
      "description": "技能说明"
    },
    {
      "name": "iconId",
      "type": "int",
      "description": "战斗 HUD 图标配置；图片路径可留空",
      "ref": "BattleIconTable",
      "min": 1
    },
    {
      "name": "action",
      "type": "enum",
      "description": "行动类型",
      "values": [
        "main",
        "secondary"
      ]
    },
    {
      "name": "cost",
      "type": "int",
      "description": "行动点消耗",
      "min": 0,
      "max": 20
    },
    {
      "name": "range",
      "type": "int",
      "description": "六边形射程；地牢原地战斗额外检查地形视线",
      "min": 0,
      "max": 12
    },
    {
      "name": "target",
      "type": "enum",
      "description": "目标规则",
      "values": [
        "enemy",
        "ally",
        "self"
      ]
    },
    {
      "name": "proficiency",
      "type": "string",
      "description": "使用的二级属性名"
    },
    {
      "name": "effectIds",
      "type": "int[]",
      "description": "顺序执行的效果",
      "ref": "CombatEffectTable"
    },
    {
      "name": "skillGroup",
      "type": "enum",
      "description": "装备与符文作用的技能标签",
      "values": [
        "weapon",
        "spell",
        "support",
        "slash"
      ]
    },
    {
      "name": "cooldownTurns",
      "type": "int",
      "description": "施放后写入冷却；自身回合开始减 1",
      "min": 0,
      "max": 20
    },
    {
      "name": "hitChance",
      "type": "int",
      "description": "每次伤害的命中百分比",
      "min": 1,
      "max": 100
    },
    {
      "name": "shots",
      "type": "int",
      "description": "独立命中/伤害次数",
      "min": 1,
      "max": 12
    },
    {
      "name": "ammoPerShot",
      "type": "int",
      "description": "每次射击消耗弹药数；0 不用弹药",
      "min": 0,
      "max": 10
    },
    {
      "name": "damageScale",
      "type": "float",
      "description": "技能伤害倍率",
      "min": 0.01,
      "max": 10
    },
    {
      "name": "actionTemplate",
      "type": "int",
      "description": "短动作模板",
      "ref": "EquipmentActionTable"
    }
  ],
