{
  "version": 1,
  "name": "CombatSkillTable",
  "description": "技能由行动类型、目标规则、消耗和效果序列组成。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "text",
      "description": "技能名称"
    },
    {
      "name": "description",
      "type": "text",
      "description": "技能说明"
    },
    {
      "name": "iconId",
      "type": "int",
      "description": "战斗 HUD 图标配置；图片路径可留空",
      "ref": "BattleIconTable",
      "min": 1
    },
    {
      "name": "action",
      "type": "enum",
      "description": "行动类型",
      "values": [
        "main",
        "secondary"
      ]
    },
    {
      "name": "cost",
      "type": "int",
      "description": "行动点消耗",
      "min": 0,
      "max": 20
    },
    {
      "name": "range",
      "type": "int",
      "description": "六边形射程；遮挡按 trajectory 弹道规则判定",
      "min": 0,
      "max": 12
    },
    {
      "name": "trajectory",
      "type": "enum",
      "description": "弹道：sight 沿用完整地形视线；direct 直射忽略攻击者相邻一格的阻挡；lobbed 抛射只检查相邻一格。直射/抛射均检查途中物体和存活角色，只用于 enemy/ally 目标技能。",
      "values": [
        "sight",
        "direct",
        "lobbed"
      ],
      "default": "sight"
    },
    {
      "name": "target",
      "type": "enum",
      "description": "目标规则；any为任意存活角色，包含自己、队友与敌人",
      "values": [
        "enemy",
        "ally",
        "self",
        "cell",
        "any"
      ]
    },
    {
      "name": "proficiency",
      "type": "string",
      "description": "使用的二级属性名"
    },
    {
      "name": "effectIds",
      "type": "int[]",
      "description": "顺序执行的效果",
      "ref": "CombatEffectTable"
    },
    {
      "name": "skillGroup",
      "type": "enum",
      "description": "装备与符文作用的技能标签",
      "values": [
        "weapon",
        "spell",
        "support",
        "slash",
        "animal",
        "construction"
      ]
    },
    {
      "name": "cooldownTurns",
      "type": "int",
      "description": "施放后写入冷却；自身回合开始减 1",
      "min": 0,
      "max": 20
    },
    {
      "name": "hitChance",
      "type": "int",
      "description": "每次伤害的命中百分比",
      "min": 1,
      "max": 100
    },
    {
      "name": "shots",
      "type": "int",
      "description": "独立命中/伤害次数",
      "min": 1,
      "max": 12
    },
    {
      "name": "ammoPerShot",
      "type": "int",
      "description": "每次射击消耗弹药数；0 不用弹药",
      "min": 0,
      "max": 10
    },
    {
      "name": "damageScale",
      "type": "float",
      "description": "技能伤害倍率",
      "min": 0.01,
      "max": 10
    },
    {
      "name": "actionTemplate",
      "type": "int",
      "description": "短动作模板",
      "ref": "EquipmentActionTable"
    },
    {
      "name": "contexts",
      "type": "enum[]",
      "description": "允许使用的阶段：life 探索，battle 正式战斗，preparation 战前部署；可多选",
      "values": [
        "life",
        "battle",
        "preparation"
      ],
      "default": [
        "battle"
      ]
    },
    {
      "name": "affectsContainers",
      "type": "bool",
      "description": "允许即时伤害作用于可破坏容器，含范围技能波及",
      "default": false
    },
    {
      "name": "skillKind",
      "type": "enum",
      "description": "技能种类；准备技能由职业学习，item仅通过消耗品使用",
      "values": [
        "active",
        "preparation",
        "item"
      ],
      "default": "active"
    },
    {
      "name": "catalystKind",
      "type": "enum",
      "description": "施放需要的触媒类型；独立于职业与装备条件",
      "values": [
        "none",
        "arcane"
      ],
      "default": "none"
    },
    {
      "name": "weaponWear",
      "type": "int",
      "min": 0,
      "max": 100,
      "default": 0,
      "description": "每次武器使用损耗；连射按发数累计，法术和非攻击默认不磨损"
    },
    {
      "name": "maxTargets",
      "type": "int",
      "min": 1,
      "max": 8,
      "default": 1,
      "description": "对敌技能最多合法目标数，配件可进一步提高"
    },
    {
      "name": "splashRadius",
      "type": "int",
      "min": 0,
      "max": 8,
      "default": 0,
      "description": "主目标周围追加合法目标的六边形半径"
    },
    {
      "name": "allowTransfer",
      "type": "bool",
      "default": false,
      "description": "允许转施符文将本自身法术改为指定距离的任意角色；仅支持可重定向的目标效果"
    }
  ],
