{
  "version": 1,
  "name": "CombatUnitTable",
  "description": "敌我共用角色模板；首版数值为可调整的 demo 样例。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "text",
      "description": "角色显示名"
    },
    {
      "name": "vitality",
      "type": "int",
      "description": "一级属性 vitality",
      "min": 0,
      "max": 1000
    },
    {
      "name": "endurance",
      "type": "int",
      "description": "一级属性 endurance",
      "min": 0,
      "max": 1000
    },
    {
      "name": "intellect",
      "type": "int",
      "description": "一级属性 intellect",
      "min": 0,
      "max": 1000
    },
    {
      "name": "strength",
      "type": "int",
      "description": "一级属性 strength",
      "min": 0,
      "max": 1000
    },
    {
      "name": "speed",
      "type": "int",
      "description": "一级属性 speed",
      "min": 0,
      "max": 1000
    },
    {
      "name": "defense",
      "type": "int",
      "description": "一级属性 defense",
      "min": 0,
      "max": 1000
    },
    {
      "name": "attributeNames",
      "type": "string[]",
      "description": "二级属性名称，与数值一一对应"
    },
    {
      "name": "attributeValues",
      "type": "int[]",
      "description": "二级属性值"
    },
    {
      "name": "maxHealth",
      "type": "formula",
      "description": "最大生命公式",
      "variables": [
        "vitality",
        "endurance"
      ]
    },
    {
      "name": "actionPoints",
      "type": "int",
      "description": "每回合行动点",
      "min": 1,
      "max": 20
    },
    {
      "name": "moveRange",
      "type": "int",
      "description": "单次移动步数",
      "min": 1,
      "max": 12
    },
    {
      "name": "moveCost",
      "type": "int",
      "description": "移动消耗行动点",
      "min": 0,
      "max": 20
    },
    {
      "name": "skillIds",
      "type": "int[]",
      "description": "角色拥有的技能",
      "ref": "CombatSkillTable"
    },
    {
      "name": "traitIds",
      "type": "int[]",
      "description": "创建角色时授予的固有特质；与实例特质同 ID 不叠加",
      "ref": "CombatTraitTable",
      "default": []
    },
    {
      "name": "bodyInjuries",
      "type": "bool",
      "description": "启用人形六部位创伤；非人形关闭",
      "default": true
    }
  ],
