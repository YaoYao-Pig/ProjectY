{
  "version": 1,
  "name": "BuffTable",
  "description": "可复用的状态定义：生命周期、周期/属性动作、互斥标签和控制效果。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "持久状态ID，与 CombatEffectTable ID 不重叠",
      "min": 10000
    },
    {
      "name": "name",
      "type": "text",
      "description": "状态名称"
    },
    {
      "name": "description",
      "type": "text",
      "description": "状态说明"
    },
    {
      "name": "iconId",
      "type": "int",
      "description": "图标",
      "ref": "BattleIconTable"
    },
    {
      "name": "color",
      "type": "string",
      "description": "状态与周期伤害飘字色（十六进制）"
    },
    {
      "name": "category",
      "type": "enum",
      "description": "状态分类",
      "values": [
        "buff",
        "debuff",
        "control"
      ]
    },
    {
      "name": "scope",
      "type": "enum",
      "description": "battle 战斗结束移除；persistent 跨战斗保留",
      "values": [
        "battle",
        "persistent"
      ]
    },
    {
      "name": "clock",
      "type": "enum",
      "description": "计时轴：回合、游戏分钟、无时限",
      "values": [
        "turns",
        "minutes",
        "infinite"
      ]
    },
    {
      "name": "durationTurns",
      "type": "int",
      "description": "回合时长",
      "min": 0
    },
    {
      "name": "durationMinutes",
      "type": "float",
      "description": "游戏分钟时长",
      "min": 0
    },
    {
      "name": "tickPhase",
      "type": "enum",
      "description": "回合计时阶段",
      "values": [
        "turn_start",
        "turn_end"
      ]
    },
    {
      "name": "periodTurns",
      "type": "int",
      "description": "周期回合间隔，无周期为0",
      "min": 0
    },
    {
      "name": "periodMinutes",
      "type": "float",
      "description": "周期游戏分钟间隔，无周期为0",
      "min": 0
    },
    {
      "name": "stacking",
      "type": "enum",
      "description": "刷新、独立实例或叠层",
      "values": [
        "refresh",
        "independent",
        "stack"
      ]
    },
    {
      "name": "maxStacks",
      "type": "int",
      "description": "最大层数",
      "min": 1,
      "max": 100
    },
    {
      "name": "removeOnDeath",
      "type": "bool",
      "description": "倒地清除"
    },
    {
      "name": "periodicEffectIds",
      "type": "int[]",
      "description": "每周期执行的瞬时伤害/治疗动作",
      "ref": "CombatEffectTable"
    },
    {
      "name": "modifierEffectIds",
      "type": "int[]",
      "description": "持续属性动作；施加时快照数值",
      "ref": "CombatEffectTable"
    },
    {
      "name": "onApplyEffectIds",
      "type": "int[]",
      "description": "成功施加时执行的瞬时动作",
      "ref": "CombatEffectTable"
    },
    {
      "name": "tags",
      "type": "string[]",
      "description": "本状态标签"
    },
    {
      "name": "blockedByTags",
      "type": "string[]",
      "description": "目标已有任一标签时拒绝施加"
    },
    {
      "name": "removeTags",
      "type": "string[]",
      "description": "成功施加时移除带任一标签的状态"
    },
    {
      "name": "skipTurn",
      "type": "bool",
      "description": "整个行动回合不可行动"
    },
    {
      "name": "manualEnemyTargets",
      "type": "bool",
      "default": false,
      "description": "匹配的远程对敌多目标技能可手动选择不同敌人，不限制主目标周边半径"
    },
    {
      "name": "ignoreProjectileBlockers",
      "type": "bool",
      "default": false,
      "description": "匹配的远程对敌技能获得追踪弹道，绕过弹道中的物体与角色阻挡"
    },
    {
      "name": "skillGroups",
      "type": "string[]",
      "default": [],
      "description": "技能能力修饰作用的显式技能组；启用追踪能力时不能为空"
    }
  ],
