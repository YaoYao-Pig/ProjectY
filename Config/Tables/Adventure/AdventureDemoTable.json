{
  "version": 1,
  "name": "AdventureDemoTable",
  "description": "演示配方；不改变大地图生成规则。野外地点取真实干燥格，建筑地点取真实实例。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "seed",
      "type": "int",
      "description": "默认种子",
      "min": 0
    },
    {
      "name": "regionIds",
      "type": "int[]",
      "description": "固定配方顺序；seededRegions=true 时为随机候选池，空数组使用全部 MapRegionTable 配置",
      "ref": "MapRegionTable"
    },
    {
      "name": "seededRegions",
      "type": "bool",
      "default": false,
      "description": "按种子分轮无放回抽取候选区域，首轮优先覆盖；false 按固定顺序生成"
    },
    {
      "name": "partyIds",
      "type": "int[]",
      "description": "初始角色模板",
      "ref": "CombatUnitTable"
    },
    {
      "name": "maxPartySize",
      "type": "int",
      "description": "队伍人数上限",
      "min": 1,
      "max": 4
    },
    {
      "name": "campEventId",
      "type": "int",
      "description": "营地事件",
      "ref": "AdventureEventTable"
    },
    {
      "name": "wildEventIds",
      "type": "int[]",
      "description": "野外事件",
      "ref": "AdventureEventTable"
    },
    {
      "name": "buildingIds",
      "type": "int[]",
      "description": "可访问建筑配置，与事件一一对应",
      "ref": "MapBuildingTable"
    },
    {
      "name": "buildingEventIds",
      "type": "int[]",
      "description": "建筑对应事件",
      "ref": "AdventureEventTable"
    },
    {
      "name": "equipmentRecipeId",
      "type": "int",
      "ref": "EquipmentDemoTable",
      "default": 1,
      "description": "开局装备配方；正式远征使用独立的基础装备包"
    },
    {
      "name": "startAreaId",
      "type": "int",
      "min": 0,
      "default": 0,
      "description": "优先靠近的开局区域配置；0沿用原点附近营地，非0要求真实生成该区域且有可达邻格"
    }
  ],
