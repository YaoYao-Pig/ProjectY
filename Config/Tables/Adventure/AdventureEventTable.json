{
  "version": 1,
  "name": "AdventureEventTable",
  "description": "大地图地点触发的探索事件；可重复由事件配置决定。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "text",
      "description": "事件标题"
    },
    {
      "name": "description",
      "type": "text",
      "description": "事件正文"
    },
    {
      "name": "repeatable",
      "type": "bool",
      "description": "返回后能否再次触发"
    },
    {
      "name": "choiceIds",
      "type": "int[]",
      "description": "选项顺序",
      "ref": "AdventureChoiceTable"
    },
    {
      "name": "presentation",
      "type": "enum",
      "description": "simple 自动结算并记日志；complex 展示通用图文选项面板",
      "values": [
        "simple",
        "complex"
      ],
      "default": "complex"
    },
    {
      "name": "illustration",
      "type": "string",
      "description": "Sprite 资源路径；复杂事件必须配置",
      "default": "Assets/DynamicAsset/UI/Art/Story/Wayfarers.png"
    },
    {
      "name": "actorAttribute",
      "type": "string",
      "description": "故事主角由最高此属性的存活队员担任；空为首名，平手按队伍顺序",
      "default": ""
    },
    {
      "name": "logKind",
      "type": "string",
      "description": "引用 StoryLogTemplateTable.kind",
      "default": "event"
    }
  ],
  "rows": [
    {
      "id": 1,
      "name": "废墟前的脚印",
      "description": "石门半掩，里面传来金属碰撞声。队伍可以迎战，也可以凭侦察寻找遗留补给。",
      "repeatable": false,
      "choiceIds": [
        1,
        2,
        3
      ],
      "presentation": "complex",
      "illustration": "Assets/DynamicAsset/UI/Art/Story/Wayfarers.png",
      "actorAttribute": "",
      "logKind": "event"
    },
    {
      "id": 2,
      "name": "移动营地",
      "description": "火堆仍然温暖。在这里整理装备、照料伤员，为下一次出发做准备。",
      "repeatable": true,
      "choiceIds": [
        4,
        3
      ],
      "presentation": "complex",
      "illustration": "Assets/DynamicAsset/UI/Art/Story/Wayfarers.png",
      "actorAttribute": "",
      "logKind": "event"
    },
    {
      "id": 3,
      "name": "林间岔路",
      "description": "草丛里有一只破损的补给箱。树后有人影闪过，继续搜索需要一名熟悉野外的队员。",
      "repeatable": false,
      "choiceIds": [
        2,
        1,
        3
      ],
      "presentation": "complex",
      "illustration": "Assets/DynamicAsset/UI/Art/Story/Wayfarers.png",
      "actorAttribute": "",
      "logKind": "event"
    },
    {
      "id": 4,
      "name": "城镇补给站",
