{
  "version": 1,
  "name": "AdventureEventTable",
  "description": "大地图地点触发的探索事件；可重复由事件配置决定。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "text",
      "description": "事件标题"
    },
    {
      "name": "description",
      "type": "text",
      "description": "事件正文"
    },
    {
      "name": "repeatable",
      "type": "bool",
      "description": "返回后能否再次触发"
    },
    {
      "name": "choiceIds",
      "type": "int[]",
      "description": "选项顺序",
      "ref": "AdventureChoiceTable"
    },
    {
      "name": "presentation",
      "type": "enum",
      "description": "simple 自动结算并记日志；complex 展示通用图文选项面板",
      "values": [
        "simple",
        "complex"
      ],
      "default": "complex"
    },
    {
      "name": "illustration",
      "type": "string",
      "description": "Sprite 资源路径；复杂事件必须配置",
      "default": "Assets/DynamicAsset/UI/Art/Story/Wayfarers.png"
    },
    {
      "name": "actorAttribute",
      "type": "string",
      "description": "故事主角由最高此属性的存活队员担任；空为首名，平手按队伍顺序",
      "default": ""
    },
    {
      "name": "logKind",
      "type": "string",
      "description": "引用 StoryLogTemplateTable.kind",
      "default": "event"
    }
  ],
  "rows": [
