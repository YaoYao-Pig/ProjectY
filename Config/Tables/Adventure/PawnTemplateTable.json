{
  "version": 1,
  "name": "PawnTemplateTable",
  "description": "角色模板对应的初始棋子外观；装备与身体独立，为之后实际装备显示提供组合入口。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定外观模板 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "text",
      "description": "模板名称"
    },
    {
      "name": "unitId",
      "type": "int",
      "description": "角色模板 ID；每个角色模板只能对应一个初始外观",
      "ref": "CombatUnitTable"
    },
    {
      "name": "partIds",
      "type": "int[]",
      "description": "部件组合；必须包含身体和底座，其余插槽可不装备",
      "ref": "PawnPartTable"
    },
    {
      "name": "appearancePoolId",
      "type": "int",
      "description": "角色/敌群创建时使用的外观池；显示刷新不重新随机",
      "ref": "CharacterAppearancePoolTable",
      "default": 1
    }
  ],
