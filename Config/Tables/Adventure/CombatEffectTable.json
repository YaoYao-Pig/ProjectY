{
  "version": 1,
  "name": "CombatEffectTable",
  "description": "可由技能组合或独立施加的 GameEffect；即时、定时与无限持续效果共用定义。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "kind",
      "type": "enum",
      "description": "效果处理器",
      "values": [
        "damage",
        "heal",
        "guard",
        "reload",
        "tame",
        "relocate",
        "modifier"
      ]
    },
    {
      "name": "amount",
      "type": "formula",
      "description": "效果数值；defense/guard 来自目标，其余来自施法者",
      "variables": [
        "vitality",
        "endurance",
        "intellect",
        "strength",
        "speed",
        "defense",
        "proficiency",
        "guard",
        "distance"
      ]
    },
    {
      "name": "name",
      "type": "text",
      "description": "持续效果显示名称；即时效果可留空",
      "default": ""
    },
    {
      "name": "description",
      "type": "text",
      "description": "状态图标的说明",
      "default": ""
    },
    {
      "name": "iconId",
      "type": "int",
      "description": "状态图标，空 Sprite 时显示名称首字",
      "ref": "BattleIconTable",
      "default": 1
    },
    {
      "name": "duration",
      "type": "enum",
      "description": "生命周期",
      "values": [
        "instant",
        "duration",
        "infinite"
      ],
      "default": "instant"
    },
    {
      "name": "durationTurns",
      "type": "int",
      "description": "有限持续回合数",
      "min": 0,
      "max": 1000000,
      "default": 0
    },
    {
      "name": "periodTurns",
      "type": "int",
      "description": "伤害/治疗触发间隔；属性效果为 0",
      "min": 0,
      "max": 1000000,
      "default": 0
    },
    {
      "name": "tickPhase",
      "type": "enum",
      "description": "目标回合开始或结束；探索时同一世界回合各推进一次对应阶段",
      "values": [
        "turn_start",
        "turn_end"
      ],
      "default": "turn_start"
    },
    {
      "name": "stacking",
      "type": "enum",
      "description": "按目标与效果 ID 刷新计时、创建独立实例或叠层并刷新计时；数值在施加时快照",
      "values": [
        "refresh",
        "independent",
        "stack"
      ],
      "default": "refresh"
    },
    {
      "name": "maxStacks",
      "type": "int",
      "description": "叠层上限；非叠层模式为 1",
      "min": 1,
      "max": 100,
      "default": 1
    },
    {
      "name": "removeOnBattleEnd",
      "type": "bool",
      "description": "战斗结束时移除，否则保留并参与探索世界回合",
      "default": true
    },
    {
      "name": "removeOnDeath",
      "type": "bool",
      "description": "目标倒地时移除",
      "default": true
    },
    {
      "name": "attribute",
      "type": "string",
      "description": "modifier 修改的角色属性；amount 支持负值",
      "default": ""
    }
  ],
  "rows": [
    {
      "id": 1,
      "kind": "damage",
      "amount": "max(1, floor(7 + strength + proficiency / 2 - defense - guard))"
    },
    {
      "id": 2,
      "kind": "damage",
      "amount": "max(1, floor(5 + strength + proficiency / 2 - defense - guard))"
    },
    {
      "id": 3,
      "kind": "damage",
      "amount": "max(1, floor(6 + intellect + proficiency / 2 - defense / 2 - guard))"
    },
    {
      "id": 4,
      "kind": "guard",
      "amount": "3"
    },
    {
      "id": 5,
      "kind": "heal",
      "amount": "6 + intellect"
    },
    {
      "id": 6,
      "kind": "reload",
      "amount": "0"
    },
    {
      "id": 7,
      "kind": "damage",
      "amount": "max(1, floor(6 + strength + proficiency / 2 - defense - guard))"
    },
    {
      "id": 8,
      "kind": "damage",
      "amount": "max(1, floor(8 + intellect + proficiency / 2 - defense / 2 - guard))"
    },
    {
      "id": 9,
      "kind": "damage",
      "amount": "max(1,floor(5+strength+proficiency/2-defense-guard))"
    },
    {
      "id": 10,
      "kind": "damage",
      "amount": "max(1,floor(8+strength*1.2+proficiency/2-defense-guard))"
    },
    {
      "id": 11,
      "kind": "damage",
      "amount": "max(1,floor(10+strength*1.5+proficiency/2-defense-guard))"
    },
    {
      "id": 201,
      "kind": "tame",
      "amount": "0"
    },
    {
      "id": 202,
      "kind": "damage",
      "amount": "max(1,floor(5 + strength + distance * 4 - defense - guard))"
    },
    {
      "id": 203,
      "kind": "damage",
      "amount": "max(1,floor(4 + strength - defense - guard))"
    },
    {
      "id": 204,
      "kind": "relocate",
      "amount": "0"
    }
  ]
}
