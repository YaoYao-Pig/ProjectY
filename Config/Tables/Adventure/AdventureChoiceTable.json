{
  "version": 1,
  "name": "AdventureChoiceTable",
  "description": "事件选择；校验条件后一次性消费，再应用结果。遭遇奖励只在获胜后发放。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "label",
      "type": "text",
      "description": "选项文案"
    },
    {
      "name": "result",
      "type": "text",
      "description": "结果说明"
    },
    {
      "name": "minScouting",
      "type": "int",
      "description": "队伍最高侦察需求",
      "min": 0,
      "max": 1000
    },
    {
      "name": "costCoins",
      "type": "int",
      "description": "选择消耗金币",
      "min": 0,
      "max": 10000
    },
    {
      "name": "rewardCoins",
      "type": "int",
      "description": "即时金币奖励",
      "min": 0,
      "max": 10000
    },
    {
      "name": "healParty",
      "type": "bool",
      "description": "恢复队伍至满生命，含倒地角色"
    },
    {
      "name": "traitIds",
      "type": "int[]",
      "description": "授予首名存活角色的特质",
      "ref": "CombatTraitTable"
    },
    {
      "name": "encounterIds",
      "type": "int[]",
      "description": "空为普通结果；有值时必须仅一个遭遇",
      "ref": "CombatEncounterTable"
    }
  ],
