{
  "version": 1,
  "name": "AdventureChoiceTable",
  "description": "事件选择；校验条件后一次性消费，再应用结果。遭遇奖励只在获胜后发放。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "label",
      "type": "text",
      "description": "选项文案"
    },
    {
      "name": "result",
      "type": "text",
      "description": "结果说明"
    },
    {
      "name": "minScouting",
      "type": "int",
      "description": "队伍最高侦察需求",
      "min": 0,
      "max": 1000
    },
    {
      "name": "costCoins",
      "type": "int",
      "description": "选择消耗金币",
      "min": 0,
      "max": 10000
    },
    {
      "name": "rewardCoins",
      "type": "int",
      "description": "即时金币奖励",
      "min": 0,
      "max": 10000
    },
    {
      "name": "healParty",
      "type": "bool",
      "description": "恢复队伍至满生命，含倒地角色"
    },
    {
      "name": "traitIds",
      "type": "int[]",
      "description": "授予首名存活角色的特质",
      "ref": "CombatTraitTable"
    },
    {
      "name": "encounterIds",
      "type": "int[]",
      "description": "空为普通结果；有值时必须仅一个遭遇",
      "ref": "CombatEncounterTable"
    },
    {
      "name": "requiredTraitIds",
      "type": "int[]",
      "description": "故事主角必须具备的特质",
      "ref": "CombatTraitTable",
      "default": []
    },
    {
      "name": "forbiddenTraitIds",
      "type": "int[]",
      "description": "故事主角不可具备的特质",
      "ref": "CombatTraitTable",
      "default": []
    },
    {
      "name": "removeTraitIds",
      "type": "int[]",
      "description": "移除受益者特质",
      "ref": "CombatTraitTable",
      "default": []
    },
    {
      "name": "unlockTreeIds",
      "type": "int[]",
      "description": "解锁受益者天赋树",
      "ref": "TalentTreeTable",
      "default": []
    },
    {
      "name": "experience",
      "type": "int",
      "description": "受益者获得经验",
      "min": 0,
      "default": 0
    },
    {
      "name": "potentialPoints",
      "type": "int",
      "description": "释放最多多少锁住的潜力点",
      "min": 0,
      "default": 0
    },
    {
      "name": "recipient",
      "type": "enum",
      "description": "特质、树、潜力、经验的受益者",
      "values": [
        "subject",
        "party"
      ],
      "default": "subject"
    },
    {
      "name": "itemIds",
      "type": "int[]",
      "description": "获得的共享背包物品",
      "ref": "EquipmentItemTable"
    },
    {
      "name": "itemCounts",
      "type": "int[]",
      "description": "对应物品数量，正数"
    },
    {
      "name": "obstacleAction",
      "type": "enum",
      "description": "临时障碍交互动作；空为普通事件",
      "values": [
        "",
        "tool",
        "manual",
        "leave"
      ],
      "default": ""
    },
    {
      "name": "effectIds",
      "type": "int[]",
      "default": [],
      "ref": "CombatEffectTable",
      "description": "结算时对存活受益者施加可复用伤害、治疗或Buff效果"
    },
    {
      "name": "timeMinutes",
      "type": "float",
      "min": 0,
      "max": 1440,
      "default": 0,
      "description": "选择花费的游戏分钟，在给予状态奖励前推进"
    },
    {
      "name": "hideRewards",
      "type": "bool",
      "default": false,
      "description": "解谜选项隐藏结果摘要，避免提前泄露答案；条件不足提示照常显示"
    }
  ],
