{
  "version": 1,
  "name": "MapAreaTownTable",
  "description": "每种聚落的设施清单、街区组合、民居和居民规模。",
  "key": "id",
  "fields": [
    {
      "name": "houseSearchRadius",
      "type": "int",
      "description": "围绕预设街区寻找完整联排空地的有限半径",
      "min": 0,
      "max": 8
    },
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "string",
      "description": "显示名称"
    },
    {
      "name": "facilityIds",
      "type": "int[]",
      "description": "本城拥有的设施，必须包含中心广场",
      "ref": "MapAreaTownFacilityTable"
    },
    {
      "name": "blockIds",
      "type": "int[]",
      "description": "随机拼接的街区预设池",
      "ref": "MapAreaTownBlockTable"
    },
    {
      "name": "houseLotIds",
      "type": "int[]",
      "description": "填充民居预设池",
      "ref": "MapAreaTownLotTable"
    },
    {
      "name": "streetLotIds",
      "type": "int[]",
      "description": "街旁装饰预设池",
      "ref": "MapAreaTownLotTable"
    },
    {
      "name": "houseCount",
      "type": "int",
      "description": "填充联排住宅的栋数；完整组合不能拆分",
      "min": 0,
      "max": 60
    },
    {
      "name": "residentCount",
      "type": "int",
      "description": "额外巡游居民数量",
      "min": 0,
      "max": 24
    },
    {
      "name": "residentTemplateIds",
      "type": "int[]",
      "description": "巡游居民模板池",
      "ref": "MapAreaTownNpcTable"
    },
    {
      "name": "plazaRadius",
      "type": "int",
      "description": "广场半径",
      "min": 3,
      "max": 6
    },
    {
      "name": "streetRadius",
      "type": "int",
      "description": "道路半宽，至少为 1",
      "min": 1,
      "max": 3
    },
    {
      "name": "treeCount",
      "type": "int",
      "description": "外围景观树数量",
      "min": 0,
      "max": 80
    },
    {
      "name": "streetRows",
      "type": "int[]",
      "description": "低到高四条等高街的局部 r 坐标"
    },
    {
      "name": "halfWidth",
      "type": "int",
      "description": "街区半宽，以 q+r/2 衡量",
      "min": 18,
      "max": 22
    },
    {
      "name": "terraceHeight",
      "type": "float",
      "description": "相邻台地高差（米），乘 Region reliefScale",
      "min": 2.2,
      "max": 3.2
    },
    {
      "name": "valleyHalfWidth",
      "type": "float",
      "description": "穿城低街半宽，桥路从上方跨过",
      "min": 3,
      "max": 5
    },
    {
      "name": "rampLength",
      "type": "int",
      "description": "每段台阶或坡道的水平跨度（格）",
      "min": 4,
      "max": 8
    },
    {
      "name": "stairRise",
      "type": "float",
      "description": "显示台阶高度（米）",
      "min": 0.1,
      "max": 0.3
    },
    {
      "name": "maxWalkRise",
      "type": "float",
      "description": "相邻地格中心允许的最大升降",
      "min": 0.5,
      "max": 1.2
    },
    {
      "name": "maxEdgeRise",
      "type": "float",
      "description": "相邻地格接边允许的最大落差",
      "min": 0.05,
      "max": 0.6
    },
    {
      "name": "bridgeWidth",
      "type": "int",
      "description": "上层桥路净宽（奇数格）",
      "min": 3,
      "max": 5
    },
    {
      "name": "bridgeThickness",
      "type": "float",
      "description": "桥面厚度（米）",
      "min": 0.2,
      "max": 0.5
    },
    {
      "name": "bridgeClearance",
      "type": "float",
      "description": "桥面底部距桥下道路的最低净空（米）",
      "min": 3,
      "max": 4
    },
    {
      "name": "bridgeAssetId",
      "type": "int",
      "description": "桥栏与桥梁模型，由生成结果提供非等比尺寸",
      "min": 1,
      "ref": "MapAssetTable"
    },
    {
      "name": "rampWidth",
      "type": "int",
      "description": "台阶与坡道的净宽（格）",
      "min": 3,
      "max": 5
    },
    {
      "name": "lotSlideCells",
      "type": "int",
      "description": "联排沿等高线可外移的最大格数，保持坡道口连通",
      "min": 0,
      "max": 6
    },
    {
      "name": "royalLayoutIds",
      "type": "int[]",
      "ref": "MapAreaRoyalTable",
      "default": [],
      "description": "王城轴线预设池；空数组使用普通山城策略"
    },
    {
      "name": "facilitySlideRows",
      "type": "int[]",
      "description": "设施沿街区纵向的候选偏移，保持平坦占地和桥头净空"
    },
    {
      "name": "surfaceProfileId",
      "type": "int",
      "description": "城镇地面配方",
      "ref": "MapAreaTownSurfaceTable"
    }
  ],
