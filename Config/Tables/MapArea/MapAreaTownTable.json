{
  "version": 1,
  "name": "MapAreaTownTable",
  "description": "每种聚落的设施清单、街区组合、民居和居民规模。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
