    {
      "name": "name",
      "type": "string",
      "description": "显示名称"
    },
    {
      "name": "facilityIds",
      "type": "int[]",
      "description": "本城拥有的设施，必须包含中心广场",
      "ref": "MapAreaTownFacilityTable"
    },
    {
      "name": "blockIds",
      "type": "int[]",
      "description": "随机拼接的街区预设池",
      "ref": "MapAreaTownBlockTable"
    },
    {
      "name": "houseLotIds",
      "type": "int[]",
      "description": "填充民居预设池",
      "ref": "MapAreaTownLotTable"
    },
    {
      "name": "streetLotIds",
      "type": "int[]",
      "description": "街旁装饰预设池",
      "ref": "MapAreaTownLotTable"
    },
    {
      "name": "houseCount",
      "type": "int",
      "description": "民居数量",
      "min": 0,
      "max": 14
    },
    {
      "name": "residentCount",
      "type": "int",
      "description": "额外巡游居民数量",
      "min": 0,
      "max": 24
    },
    {
      "name": "residentTemplateIds",
      "type": "int[]",
      "description": "巡游居民模板池",
      "ref": "MapAreaTownNpcTable"
    },
    {
      "name": "blockDistance",
      "type": "int",
      "description": "街区中心距广场的轴向半径",
      "min": 10,
      "max": 16
    },
    {
      "name": "plazaRadius",
      "type": "int",
      "description": "广场半径",
      "min": 3,
      "max": 6
    },
    {
      "name": "streetRadius",
      "type": "int",
      "description": "道路半宽，至少为 1",
      "min": 1,
      "max": 3
    },
    {
      "name": "treeCount",
