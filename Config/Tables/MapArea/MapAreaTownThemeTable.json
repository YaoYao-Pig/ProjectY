{
  "version": 1,
  "name": "MapAreaTownThemeTable",
  "description": "大地图 Region 对城镇的地面、铺装、植被与台地高差影响。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "string",
      "description": "显示名称"
    },
    {
      "name": "regionType",
      "type": "enum",
      "description": "来源 Region",
      "enumRef": "Map.E_MapRegion"
    },
    {
      "name": "floorColor",
      "type": "string",
      "description": "庭院地面颜色"
    },
    {
      "name": "wallColor",
      "type": "string",
      "description": "边界颜色"
    },
    {
      "name": "wallHeight",
      "type": "float",
      "description": "边界高度",
      "min": 0
    },
    {
      "name": "heightNoise",
      "type": "float",
      "description": "地面噪声幅度",
      "min": 0
    },
    {
      "name": "assetId",
      "type": "int",
      "description": "地面资源",
      "ref": "MapAssetTable"
    },
    {
      "name": "roadColor",
      "type": "string",
      "description": "街道铺装颜色"
    },
    {
      "name": "plazaColor",
      "type": "string",
      "description": "广场铺装颜色"
    },
    {
      "name": "treeAssetId",
      "type": "int",
      "description": "景观树资源",
      "ref": "MapAssetTable"
    },
    {
      "name": "treeScale",
      "type": "float",
      "description": "景观树相对比例",
      "min": 0.1
    },
    {
      "name": "reliefScale",
      "type": "float",
      "description": "Region 对山城台地高差的影响",
      "min": 1,
      "max": 1.3
    },
    {
      "name": "outsideSurfaceId",
      "type": "int",
      "description": "城外 Region 地表",
      "ref": "MapAreaSurfaceTable"
    }
  ],
