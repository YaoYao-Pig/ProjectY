{
  "version": 1,
  "name": "MapAreaTownInteriorTable",
  "description": "与街道共用坐标的真实室内；建筑核心与可剖切上盖分离",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "ref": "MapAreaTownLotTable",
      "description": "对应完整建筑地块 ID"
    },
    {
      "name": "name",
      "type": "string",
      "description": "室内类型"
    },
    {
      "name": "coverAssetId",
      "type": "int",
      "ref": "MapAssetTable",
      "description": "进入后剖切隐藏的上墙和屋顶"
    },
    {
      "name": "navRadius",
      "type": "float",
      "description": "模型与导航制作时的地格半径，改变时需要同步重制占地"
    },
    {
      "name": "interiorQ",
      "type": "int[]",
      "description": "可走室内地格 q，不含墙和家具"
    },
    {
      "name": "interiorR",
      "type": "int[]",
      "description": "可走室内地格 r"
    },
    {
      "name": "serviceQ",
      "type": "int",
      "description": "室内介绍/服务点 q"
    },
    {
      "name": "serviceR",
      "type": "int",
      "description": "室内介绍/服务点 r"
    },
    {
      "name": "floorColor",
      "type": "string",
      "description": "室内地面纯色"
    },
    {
      "name": "doorWidth",
      "type": "float",
      "description": "门洞净宽，米"
    },
    {
      "name": "doorHeight",
      "type": "float",
      "description": "门洞净高，米"
    },
    {
      "name": "storeyHeight",
      "type": "float",
      "description": "首层层高，米"
    },
    {
      "name": "surfaceId",
      "type": "int",
      "description": "室内地面材质",
      "ref": "MapAreaSurfaceTable"
    },
    {
      "name": "doorQ",
      "type": "int[]",
      "default": [],
      "description": "明确门洞边的室外格 q；空数组沿用地块主入口"
    },
    {
      "name": "doorR",
      "type": "int[]",
      "default": [],
      "description": "明确门洞边的室外格 r"
    },
    {
      "name": "doorInsideQ",
      "type": "int[]",
      "default": [],
      "description": "每条门洞边的室内格 q，与 doorQ 一一对应"
    },
    {
      "name": "doorInsideR",
      "type": "int[]",
      "default": [],
      "description": "每条门洞边的室内格 r"
    }
  ],
