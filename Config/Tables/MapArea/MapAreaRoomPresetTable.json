{
  "version": 1,
  "name": "MapAreaRoomPresetTable",
  "description": "三级预设：固定格罩及固定陈设组合；仅整体旋转和平移。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "string",
      "description": "预设大房间名称"
    },
    {
      "name": "radius",
      "type": "int",
      "description": "本地轴向格罩半径",
      "min": 6,
      "max": 20
    },
    {
      "name": "tiles",
      "type": "string[]",
      "description": "固定格罩：按 r 再 q 排列，. 为地面，# 为墙；宽高均为 2r+1"
    },
    {
      "name": "floorAccent",
      "type": "string",
      "description": "预设铺地色 #RRGGBB"
    },
    {
      "name": "districtId",
      "type": "int",
      "description": "所属功能分区",
      "ref": "MapAreaDistrictTable"
    },
    {
      "name": "dressingPropIds",
      "type": "int[]",
      "description": "追加环境陈设，不占战斗保留区",
      "ref": "MapAreaPropTable"
    },
    {
      "name": "dressingCount",
      "type": "int",
      "description": "追加陈设上限",
      "min": 0,
      "max": 16
    },
    {
      "name": "floorSurfaceIds",
      "type": "int[]",
      "description": "房间地面材质池，空数组使用 Region 配方",
      "ref": "MapAreaSurfaceTable"
    },
    {
      "name": "wallSurfaceIds",
      "type": "int[]",
      "description": "房间墙材池",
      "ref": "MapAreaSurfaceTable"
    }
  ],
