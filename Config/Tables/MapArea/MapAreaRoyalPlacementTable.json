{
  "version": 1,
  "name": "MapAreaRoyalPlacementTable",
  "description": "片区内的地块意图：先设施和主路，再临街住宅，最后绿地陈设",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "min": 1,
      "description": "摆放 ID"
    },
    {
      "name": "name",
      "type": "string",
      "description": "预设名称"
    },
    {
      "name": "localQ",
      "type": "int",
      "description": "局部 q"
    },
    {
      "name": "localR",
      "type": "int",
      "description": "局部 r"
    },
    {
      "name": "lotIds",
      "type": "int[]",
      "ref": "MapAreaTownLotTable",
      "description": "随机外观池，设施项可为空"
    },
    {
      "name": "facilityId",
      "type": "int",
      "min": 0,
      "description": "设施 ID，0 表示陈设/住宅"
    },
    {
      "name": "districtId",
      "type": "int",
      "description": "所属功能片区",
      "ref": "MapAreaRoyalDistrictTable"
    },
    {
      "name": "role",
      "type": "enum",
      "description": "生成阶段",
      "values": [
        "landmark",
        "facility",
        "house",
        "garden",
        "detail"
      ]
    },
    {
      "name": "searchRadius",
      "type": "int",
      "description": "相对目标锚点的有限搜索半径",
      "min": 0,
      "max": 20
    },
    {
      "name": "rotations",
      "type": "int[]",
      "description": "允许的六方向朝向；住宅按临街评分选择"
    },
    {
      "name": "required",
      "type": "bool",
      "description": "必需地块找不到合法位置时明确报错；可选景观记录未摆放原因"
    }
  ],
