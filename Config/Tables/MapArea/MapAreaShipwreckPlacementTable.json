      "type": "int",
      "description": "相对船中心轴向r"
    },
    {
      "name": "layer",
      "type": "int",
      "description": "摆放楼层"
    },
    {
      "name": "height",
      "type": "float",
      "description": "模型根节点绝对Y"
    },
    {
      "name": "yaw",
      "type": "float",
      "description": "Unity角度"
    },
    {
