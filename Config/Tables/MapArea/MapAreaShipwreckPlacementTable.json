    },
    {
      "name": "interiorId",
      "type": "int",
      "description": "局部舱室剖切身份，0自动取摆放格"
    },
    {
      "name": "surfaceHeight",
      "type": "float",
      "description": "可摆小物的水平顶面，相对模型根；0无桌面"
    },
    {
      "name": "surfaceMinX",
