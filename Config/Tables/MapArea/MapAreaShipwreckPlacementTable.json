      "description": "阻挡矩形本地中心X"
    },
    {
      "name": "centerZ",
      "type": "float",
      "description": "阻挡矩形本地中心Z"
    },
    {
      "name": "doorHalfWidth",
      "type": "float",
      "description": "实体墙门洞半宽，0为无门",
      "min": 0
    },
    {
      "name": "blocksMovement",
      "type": "bool",
      "description": "阻挡实体占地"
    },
    {
      "name": "cameraObstacle",
      "type": "bool",
      "description": "参与相机避障"
    },
    {
      "name": "structural",
      "type": "bool",
      "description": "船体共享原点结构，锚点只控制显示"
    },
    {
