{
  "version": 1,
  "name": "MapAreaShipwreckPlacementTable",
  "description": "共享原点船壳、真实舱壁门洞和米制家具；桌面支撑供小物池使用。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "固定摆件编号",
      "min": 1
    },
    {
