{
  "version": 1,
  "name": "MapAreaThemeTable",
  "description": "根据入口所在 Region 选择地牢形态与材质；不按地貌 ID 在渲染器中硬编码。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "regionType",
      "type": "enum",
      "description": "适用大地图地貌",
      "enumRef": "Map.E_MapRegion"
    },
    {
      "name": "name",
      "type": "string",
      "description": "环境主题"
    },
    {
      "name": "floorColor",
      "type": "string",
      "description": "地面纯色 #RRGGBB"
    },
    {
      "name": "wallColor",
      "type": "string",
      "description": "墙体纯色 #RRGGBB"
    },
    {
      "name": "wallHeight",
      "type": "float",
      "description": "墙体高度",
      "min": 0.5,
      "max": 5
    },
    {
      "name": "roomRadiusScale",
      "type": "float",
      "description": "房间尺寸倍率",
      "min": 0.6,
      "max": 1.4
    },
    {
      "name": "windingScale",
      "type": "float",
      "description": "走廊曲折倍率",
      "min": 0,
      "max": 2
    },
    {
      "name": "heightNoise",
      "type": "float",
      "description": "地面小幅起伏，不改变可通行性",
      "min": 0,
      "max": 0.25
    },
    {
      "name": "assetId",
      "type": "int",
      "description": "地面与墙体柱模型",
      "ref": "MapAssetTable"
    },
    {
      "name": "surfaceProfileId",
      "type": "int",
      "description": "地牢基础材质与地貌覆盖",
      "ref": "MapAreaDungeonSurfaceTable"
    }
  ],
