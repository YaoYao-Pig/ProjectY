{
  "version": 1,
  "name": "MapAreaPropTable",
  "description": "地牢建筑与陈设；模型占地阻挡移动，视线阻挡独立配置。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "string",
      "description": "陈设名称"
    },
    {
      "name": "assetId",
      "type": "int",
      "description": "复用地图资源表中的模型",
      "ref": "MapAssetTable"
    },
    {
      "name": "blocksSight",
      "type": "bool",
      "description": "是否遮挡视线"
    },
    {
      "name": "scale",
      "type": "float",
      "description": "模型等比缩放，须留在所配置占地内",
      "min": 0.1,
      "max": 1
    },
    {
      "name": "footprintQ",
      "type": "int[]",
      "description": "占地格局部 q，与 footprintR 一一对应，随模型旋转"
    },
    {
      "name": "footprintR",
      "type": "int[]",
      "description": "占地格局部 r"
    },
    {
      "name": "placement",
      "type": "string",
      "description": "随机摆放方式：wall 沿墙、island 成片、aligned 与房间轴对齐"
    },
    {
      "name": "scaleMode",
      "type": "enum",
      "description": "grid 随地格缩放；meters 保持模型真实米制",
      "values": [
        "grid",
        "meters"
      ]
    }
  ],
