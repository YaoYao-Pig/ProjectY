{
  "version": 1,
  "name": "MapAreaRoomStyleTable",
  "description": "二级房间的形状、边缘变化与外围陈设组合。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "string",
      "description": "房间策略名称"
    },
    {
      "name": "shape",
      "type": "string",
      "description": "注册形状：cavern / hall / lobed"
    },
    {
      "name": "roughness",
      "type": "float",
      "description": "边缘起伏幅度",
      "min": 0,
      "max": 3
    },
    {
      "name": "propIds",
      "type": "int[]",
      "description": "外围陈设池",
      "ref": "MapAreaPropTable"
    },
    {
      "name": "propCount",
      "type": "int",
      "description": "目标陈设数量，受净宽和连通性约束可减少",
      "min": 0,
      "max": 25
    },
    {
      "name": "districtId",
      "type": "int",
      "description": "所属功能分区",
      "ref": "MapAreaDistrictTable"
    },
    {
      "name": "propCoverage",
      "type": "float",
      "description": "目标物件占用地面比例；受净空与连通约束",
      "min": 0.05,
      "max": 0.4
    },
    {
      "name": "dressingPropIds",
      "type": "int[]",
      "description": "追加环境陈设，不占战斗保留区",
      "ref": "MapAreaPropTable"
    },
    {
      "name": "dressingCount",
      "type": "int",
      "description": "追加陈设上限",
      "min": 0,
      "max": 16
    },
    {
      "name": "floorSurfaceIds",
      "type": "int[]",
      "description": "房间地面材质池，空数组使用 Region 配方",
      "ref": "MapAreaSurfaceTable"
    },
    {
      "name": "wallSurfaceIds",
      "type": "int[]",
      "description": "房间墙材池",
      "ref": "MapAreaSurfaceTable"
    }
  ],
