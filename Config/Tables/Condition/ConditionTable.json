{
  "version": 1,
  "name": "ConditionTable",
  "description": "可复用的只读条件图。all/any/not 组合子条件，其他 kind 由 Lua 注册校验与求值处理器；无隐式通过的空条件。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定条件 ID",
      "min": 1
    },
    {
      "name": "kind",
      "type": "string",
      "description": "条件类型；组合类型为 all/any/not，扩展类型通过 ConditionSystem:Register 注册"
    },
    {
      "name": "conditionIds",
      "type": "int[]",
      "description": "组合节点的子条件；叶子为空，not 必须且只能有一个子条件",
      "ref": "ConditionTable",
      "default": []
    },
    {
      "name": "targetId",
      "type": "int",
      "description": "叶子处理器定义的目标配置 ID；由对应处理器校验引用",
      "default": 0
    },
    {
      "name": "key",
      "type": "string",
      "description": "叶子处理器定义的事实键",
      "default": ""
    },
    {
      "name": "value",
      "type": "int",
      "description": "叶子处理器定义的整数阈值或参数",
      "default": 0
    },
    {
      "name": "state",
      "type": "string",
      "description": "叶子处理器定义的目标状态",
      "default": ""
    },
    {
      "name": "reason",
      "type": "text",
      "description": "条件不满足时显示的原因，必须非空"
    }
  ],
