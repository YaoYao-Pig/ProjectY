{
  "version": 1,
  "name": "MapAreaChestRuleTable",
  "description": "地图生成期容器计划；生成概率按每条规则判定，数量在命中后抽取。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "areaId",
      "type": "int",
      "description": "小地图配置",
      "ref": "MapAreaTable"
    },
    {
      "name": "lootTableId",
      "type": "int",
      "description": "宝箱与内容定义",
      "ref": "EquipmentLootTable"
    },
    {
      "name": "strategy",
      "type": "enum",
      "description": "候选位置策略",
      "values": [
        "reachable",
        "rooms",
        "wall",
        "goal",
        "fixed",
        "props"
      ]
    },
    {
      "name": "minCount",
      "type": "int",
      "description": "最少宝箱数",
      "min": 0,
      "max": 100
    },
    {
      "name": "maxCount",
      "type": "int",
      "description": "最多宝箱数",
      "min": 0,
      "max": 100
    },
    {
      "name": "minDistance",
      "type": "int",
      "description": "距入口最小寻路距离",
      "min": 0
    },
    {
      "name": "maxDistance",
      "type": "int",
      "description": "距入口最大寻路距离",
      "min": 0
    },
    {
      "name": "spacing",
      "type": "int",
      "description": "宝箱间最小六边形格距",
      "min": 1
    },
    {
      "name": "seedSalt",
      "type": "int",
      "description": "独立随机通道",
      "min": 0
    },
    {
      "name": "layer",
      "type": "int",
      "description": "目标楼层；-1为任意层",
      "min": -1,
      "default": -1
    },
    {
      "name": "spawnChance",
      "type": "float",
      "description": "整张小地图每条规则独立出现概率（百分比）",
      "default": 100,
      "min": 0,
      "max": 100
    },
    {
      "name": "poolOverrideId",
      "type": "int",
      "description": "覆盖容器默认掉落池；0 使用默认",
      "default": 0,
      "min": 0
    },
    {
      "name": "roomStyleId",
      "type": "int",
      "description": "限定房间样式；0 不限",
      "default": 0,
      "min": 0
    },
    {
      "name": "districtId",
      "type": "int",
      "description": "限定功能分区；0 不限",
      "default": 0,
      "min": 0
    },
    {
      "name": "presetId",
      "type": "int",
      "description": "限定预设房间；0 不限",
      "default": 0,
      "min": 0
    },
    {
      "name": "propId",
      "type": "int",
      "description": "props 策略匹配 MapAreaPropTable，将陈设关联为同一容器",
      "default": 0,
      "min": 0
    },
    {
      "name": "q",
      "type": "int",
      "description": "fixed 策略锚点 q",
      "default": 0
    },
    {
      "name": "r",
      "type": "int",
      "description": "fixed 策略锚点 r",
      "default": 0
    },
    {
      "name": "rotation",
      "type": "int",
      "description": "六向旋转；-1 随机",
      "default": -1,
      "min": -1,
      "max": 5
    },
    {
      "name": "unlockEncounterId",
      "type": "int",
      "description": "本地点敌群实例 ID；清除后允许打开和破坏，0 无条件",
      "default": 0,
      "min": 0
    }
  ],
