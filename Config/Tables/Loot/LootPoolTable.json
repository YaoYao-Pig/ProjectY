{
  "version": 1,
  "name": "LootPoolTable",
  "description": "每个条目独立判定的掉落池；可能同时命中多项，也可能为空。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "name",
      "type": "text",
      "description": "掉落池名"
    },
    {
      "name": "seedSalt",
      "type": "int",
      "description": "独立随机通道",
      "min": 0
    },
    {
      "name": "mode",
      "type": "enum",
      "description": "逐项独立概率，或按权重抽取固定次数",
      "default": "independent",
      "values": [
        "independent",
        "weighted"
      ]
    },
    {
      "name": "drawCount",
      "type": "int",
      "description": "weighted 模式抽取次数；允许重复，同物品合并",
      "default": 1,
      "min": 1
    }
  ],
