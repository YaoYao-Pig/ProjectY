{
  "version": 1,
  "name": "QuestTable",
  "description": "Mission 的独立阶段；以条件表达并行、分支和汇合，不保存 nextQuest。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "稳定配置 ID",
      "min": 1
    },
    {
      "name": "missionId",
      "type": "int",
      "description": "所属任务",
      "ref": "MissionTable"
    },
    {
      "name": "name",
      "type": "text",
      "description": "阶段名称"
    },
    {
      "name": "description",
      "type": "text",
      "description": "阶段目标"
    },
    {
      "name": "startConditionId",
      "type": "int",
      "description": "激活条件",
      "ref": "ConditionTable"
    },
    {
      "name": "completeConditionId",
      "type": "int",
      "description": "完成条件",
      "ref": "ConditionTable"
    },
    {
      "name": "autoComplete",
      "type": "bool",
      "description": "就绪后自动完成",
      "default": true
    },
    {
      "name": "actionIds",
      "type": "int[]",
      "description": "完成动作",
      "ref": "NarrativeActionTable",
      "default": []
    }
  ],
