{
  "version": 1,
  "name": "SkillAtlasTable",
  "description": "主动技能图谱与真实研习前置；坐标只用于显示，不构成额外学习限制。",
  "key": "id",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "description": "技能 ID，与战斗技能共用身份",
      "ref": "CombatSkillTable"
    },
    {
      "name": "categoryId",
      "type": "int",
      "description": "主要二级分类",
      "ref": "SkillCategoryTable"
    },
    {
      "name": "glyphCode",
      "type": "string",
      "description": "图鉴图标代码，显式对应 GrowthAttributeTable.code；与伤害熟练度独立"
    },
    {
      "name": "relatedCategoryIds",
      "type": "int[]",
      "description": "关联目录，只跳转同一技能",
      "ref": "SkillCategoryTable"
    },
    {
      "name": "x",
      "type": "int",
      "description": "图谱横坐标",
      "min": 0
    },
    {
      "name": "y",
      "type": "int",
      "description": "图谱纵坐标",
      "min": 0
    },
    {
      "name": "prerequisiteIds",
      "type": "int[]",
      "description": "前置技能",
      "ref": "CombatSkillTable"
    },
    {
      "name": "prerequisiteMode",
      "type": "enum",
      "description": "前置满足方式",
      "values": [
        "all",
        "any"
      ]
    },
    {
      "name": "tags",
      "type": "string[]",
      "description": "搜索标签"
    }
  ],
